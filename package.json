  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.emperor.game",
    "productName": "Emperor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop.cjs",
      "desktop-runtime.cjs",
      "preload.cjs",
      "index.html",
      "src/**/*",
      "assets/**/*",
      "!assets/beauties/references/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null,
      "icon": "assets/brand/emperor.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/brand/emperor.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
